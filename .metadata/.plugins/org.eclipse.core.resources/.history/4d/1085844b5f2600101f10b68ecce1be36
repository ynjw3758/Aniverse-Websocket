<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Config 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.Anivers.Patform.Websocket.Mapper.Login.Login_Mapper">

<insert id="Login_Start" parameterType="java.util.HashMap">
insert into login_activity(user_id, login_date, login_time)
values(#{UserId},#{Login_Date}, #{Login_Start})
</insert>

<update id="Login_again" parameterType="java.util.HashMap">
update login_activity
set login_time =#{Login_Start}
where user_id =#{UserId} and login_date=#{Login_date}
</update>

<select id="Exist_days" parameterType="java.utile.HashMap" resultType="boolean">
   select EXISTS (select 1 
   from login_activity 
   where login_date=#{today}  and user_id=#{user_id});
</select>
</mapper>