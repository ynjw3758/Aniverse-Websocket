package com.Anivers.Patform.Websocket.Redis;

import java.util.List;
import java.util.Map;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.data.redis.core.RedisTemplate;
import org.springframework.stereotype.Component;

@Component("login_QueryService")
public class Query {
	
	private Logger logger = LoggerFactory.getLogger(this.getClass());
	
	@Autowired
	@Qualifier("Check_ChatMember") // 참여자 저장용
	private RedisTemplate<String, Object> CheckMember;
	
	@Autowired
	@Qualifier("LoginUserList") // 참여자 저장용
	private RedisTemplate<String, Object> LoginUserList;

    // Redis에서 해당 채팅방의 참여자인지 검사
    public boolean isUserInChat(String chatId, List<String> userId) {
    	String id ="d209ba25-bb41-4894-a3a5-def24a073ba9";
    	  boolean allExist = true;

    	    try {
    	        for (String ids : userId) {
    	            Boolean exists = CheckMember.opsForSet().isMember(id, ids);
    	            if (!Boolean.TRUE.equals(exists)) {
    	                logger.warn("❌ 유저 {} 는 채팅방 {}에 포함되어 있지 않음", ids, chatId);
    	                allExist = false;
    	                break; // 하나라도 없으면 중단
    	            }
    	        }

    	        if (allExist) {
    	            logger.info("✅ 모든 유저가 채팅방 {}에 포함됨", id);
    	        }

    	    } catch (Exception e) {
    	        logger.error("❌ Redis 체크 중 오류 발생:", e);
    	        return false;
    	    }

    	    return allExist;
    }
    
    public void LoginUserSave(Map<String, Object> infos) {
        String userId = (String) infos.get("UserId");
        String sessionId = (String) infos.get("SessionId");

        try {
            LoginUserList.opsForValue().set(userId, sessionId);
            logger.info("✅ 로그인 유저 저장 완료: {} → {}", userId, sessionId);
        } catch (Exception e) {
            logger.error("❌ 로그인 유저 저장 실패", e);
        }
    }
    
    public void LogoutUserDelete(String userId) {

        try {
            LoginUserList.delete(userId);
            logger.info("✅ 로그아웃 유저 삭제 완료: {}", userId);
        } catch (Exception e) {
            logger.error("❌ 로그아웃 유저 삭제 실패", e);
        }
    }
    
    // ✅ 유저 세션 ID 조회 (선택적)
    public String getUserSession(String userId) {
        try {
            Object value = LoginUserList.opsForValue().get(userId);
            return value != null ? value.toString() : null;
        } catch (Exception e) {
            logger.error("❌ 세션 조회 실패", e);
            return null;
        }
    }

}
