package com.Anivers.Patform.Websocket.Controller;

import java.util.Map;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.messaging.handler.annotation.MessageMapping;
import org.springframework.messaging.handler.annotation.Payload;
import org.springframework.messaging.simp.SimpMessagingTemplate;
import org.springframework.stereotype.Controller;

import com.Anivers.Patform.Websocket.Dto.ChatMessageDto;
import com.Anivers.Patform.Websocket.Redis.Query;

@Controller
public class Message_Controller {
	
	private final Logger logger = LoggerFactory.getLogger(this.getClass());
	private final SimpMessagingTemplate messagingTemplate;
	
	@Autowired
	private Query Redis;
	
    public Message_Controller(SimpMessagingTemplate messagingTemplate) {
        this.messagingTemplate = messagingTemplate; // ✅ 여기서 초기화!
    }
	
    @MessageMapping("/chat.send") // ✅ 프론트의 /app/chat.send 와 매칭됨
    public void receiveChatMessage(@Payload Map<String, Object> message) {
        System.out.println("📩 채팅 수신: " + message.get("isFirst"));
        if(message.getFirst() == false) {
            // ✅ 메시지 전송 대상: /topic/chat/{chatId}
            messagingTemplate.convertAndSend(
                "/topic/chat/" + message.getChatId(),
                message
            );
        }else {
        	String SessionId = Redis.getUserSession(message.getUserId());
        	logger.info("처음 채팅 친다 userid로 알람 보내기");
        	if (SessionId != null) {
        	    // userId를 기준으로 /user/{userId}/queue/notify 에 메시지 전송
        	    messagingTemplate.convertAndSendToUser(
        	        message.getUserId(),           // userId (principal name)
        	        "/queue/notify",               // 대상 경로 (프론트는 여기를 구독해야 함)
        	        "test"                          // 보낼 데이터
        	    );
        	    logger.info("📢 알림 전송 완료 → {}", message.getUserId());
        	} else {
        	    logger.warn("❌ 세션 ID를 찾을 수 없습니다: {}", message.getUserId());
        	}
        }
    }
}
