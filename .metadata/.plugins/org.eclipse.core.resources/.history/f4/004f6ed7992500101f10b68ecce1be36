package com.Anivers.Patform.Websocket.Handler;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.time.temporal.ChronoUnit;
import java.util.ArrayList;
import java.util.Date;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;
import org.springframework.stereotype.Service;
import org.springframework.web.socket.CloseStatus;
import org.springframework.web.socket.TextMessage;
import org.springframework.web.socket.WebSocketSession;
import org.springframework.web.socket.handler.TextWebSocketHandler;

import com.Anivers.Patform.Websocket.Mapper.Login.Login_Mapper;
import com.fasterxml.jackson.databind.ObjectMapper;

@Service("login_Services")
public class Login_Services extends TextWebSocketHandler {
	
	@Autowired
	private Login_Mapper login;

    private final ObjectMapper objectMapper = new ObjectMapper();
    private Logger logger = LoggerFactory.getLogger(this.getClass());
    private final Map<String, Map<String, String>> loginMap = new ConcurrentHashMap<>();
    
    @Override
    public void afterConnectionEstablished(WebSocketSession session) {
    	logger.info("✅ WebSocket 연결됨: " + session.getId());
    }

    @Override
    protected void handleTextMessage(WebSocketSession session, TextMessage message) throws Exception {
        String payload = message.getPayload();
        Map<String ,Object> login_info = new HashMap<>();
        logger.info("session: " + session.getId());

        // JSON 파싱
        Map<String, String> data = objectMapper.readValue(payload, Map.class);
        Map<String, String> userInfo = new HashMap<>();
        if(data.get("type").equals("login")) {
        	logger.info("로그인");
        	//todo:로그인 시 현재 log_active의 
        	if(!loginMap.containsKey(data.get("Id"))) {//로그인 기록이 없다면 단순 저장
                LocalDate today = LocalDate.now();
                logger.info("로그인 날짜  :" + today);
                LocalDateTime loging_start = LocalDateTime.now().withSecond(0).withNano(0);
	        	userInfo.put("UserId", data.get("Id"));
	        	userInfo.put("SessionId", session.getId());
	        	loginMap.put(data.get("Id"), userInfo);
	        	
	        	login_info.put("UserId", data.get("Id"));
	        	login_info.put("SessionId", session.getId());
	        	login_info.put("Login_Date", today);
	        	login_info.put("Login_Start", loging_start);
        	
        		login.Login_Start(login_info);
        	}
        	else{
        		logger.info("로그인 데이터 업데이트");
	        	userInfo.put("UserId", data.get("Id"));
	        	userInfo.put("SessionId", session.getId());
	        	loginMap.put(data.get("Id"), userInfo);
	        	
        		 LocalDateTime loging_start = LocalDateTime.now().withSecond(0).withNano(0);
	        	login_info.put("UserId", data.get("Id"));
	        	login_info.put("SessionId", session.getId());
	        	login_info.put("Login_Start", loging_start);
	        	
        		login.Login_again(login_info);
        		
        	}
        }
        else {
        	logger.info("로그아웃");
        	
        }

        // UserId를 키로 저장 → 덮어쓰기 되므로 중복 자동 제거
       
        logger.info("현재 접속자 수 :" + loginMap.size());
        //LocalDateTime login_date =log_date; 
        
        // TODO: 로그인 기록 저장, 사용자 상태 업데이트 등
    }

    @Override
    public void afterConnectionClosed(WebSocketSession session, CloseStatus status) {
    	logger.info("❌ 연결 종료: " + session.getId());
    }
}
